{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aurora-atoms.github.io/lattice/schemas/capability-run-result.v1.schema.json",
  "title":"Capability Run Result",
  "type":"object",
  "additionalProperties":false,
  "required":["record_type","capability_id","run_id","status","artifacts","evidence","success_signals","stop","generated_at"],
  "properties":{
    "record_type":{"const":"lat.capability.run_result.v1"},
    "capability_id":{"type":"string","pattern":"^(skill|agent):[a-z0-9][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "run_id":{"type":"string","minLength":1},
    "status":{"type":"string","enum":["succeeded","partial","failed","blocked","insufficient_evidence","human_review_required"]},
    "artifacts":{
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["artifact_id","kind","format","path","visible","write_status"],
        "properties":{
          "artifact_id":{"type":"string","minLength":1},
          "kind":{"type":"string","minLength":1},
          "format":{"type":"string","minLength":1},
          "path":{"type":"string","minLength":1},
          "visible":{"type":"boolean"},
          "write_status":{"type":"string","enum":["written","returned_inline","not_written"]},
          "notes":{"type":"string"}
        }
      }
    },
    "evidence":{
      "type":"object",
      "additionalProperties":false,
      "required":["facts","inference_summary","citations","uncertainty","unknowns","assumptions"],
      "properties":{
        "facts":{
          "type":"array",
          "items":{
            "type":"object",
            "additionalProperties":false,
            "required":["claim","source_refs","confidence"],
            "properties":{
              "claim":{"type":"string","minLength":1},
              "source_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
              "confidence":{"type":"string","enum":["high","medium","low"]}
            }
          }
        },
        "inference_summary":{
          "type":"array",
          "items":{
            "type":"object",
            "additionalProperties":false,
            "required":["conclusion","based_on","uncertainty"],
            "properties":{
              "conclusion":{"type":"string","minLength":1},
              "based_on":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
              "uncertainty":{"type":"string"}
            }
          }
        },
        "citations":{"type":"array","items":{"type":"string","minLength":1}},
        "uncertainty":{"type":"array","items":{"type":"string","minLength":1}},
        "unknowns":{"type":"array","items":{"type":"string","minLength":1}},
        "assumptions":{"type":"array","items":{"type":"string","minLength":1}}
      }
    },
    "success_signals":{
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["signal","result","evidence_refs"],
        "properties":{
          "signal":{"type":"string","minLength":1},
          "result":{"type":"string","enum":["met","not_met","not_evaluated"]},
          "evidence_refs":{"type":"array","items":{"type":"string","minLength":1}}
        }
      }
    },
    "stop":{
      "type":"object",
      "additionalProperties":false,
      "required":["reason","condition","retry_count","retry_allowed","next_step"],
      "properties":{
        "reason":{"type":"string","enum":["goal_reached","stage_gate_reached","retry_budget_exhausted","missing_permission","missing_required_input","source_unavailable","insufficient_evidence","high_risk_boundary","human_decision_required","explicit_user_stop","failed_validation"]},
        "condition":{"type":"string","minLength":1},
        "retry_count":{"type":"integer","minimum":0},
        "retry_allowed":{"type":"boolean"},
        "requested_permission":{"type":"string"},
        "next_step":{"type":"string","minLength":1}
      }
    },
    "generated_at":{"type":"string","format":"date-time"}
  }
}
