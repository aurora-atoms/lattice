{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-atoms.github.io/lattice/schemas/portable-case-pack.v1.schema.json",
  "title": "Lattice Portable Case Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "case_id",
    "mission_anchor_ref",
    "decision_requested",
    "audience",
    "scope",
    "evidence_cutoff",
    "claims",
    "conflicts",
    "strongest_counterevidence",
    "rejected_directions",
    "evidence_refs",
    "source_gaps",
    "next_tool_task",
    "required_output",
    "falsification",
    "data_classification"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "contract": {"const": "lat.portable_case_pack.v1"},
    "case_id": {"type": "string", "minLength": 1},
    "mission_anchor_ref": {"const": "lat.goal.verified-decision-yield.v1"},
    "decision_requested": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in", "out"],
      "properties": {
        "in": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "out": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence_cutoff": {"type": "string", "format": "date-time"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "derived", "judged", "unknown"],
      "properties": {
        "observed": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "derived": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "judged": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "unknown": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflict_id", "claim_refs", "evidence_refs", "adjudicator"],
        "properties": {
          "conflict_id": {"type": "string", "minLength": 1},
          "claim_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "adjudicator": {"type": "string", "minLength": 1}
        }
      }
    },
    "strongest_counterevidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "evidence_refs", "impact"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "impact": {"type": "string", "minLength": 1}
        }
      }
    },
    "rejected_directions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["direction", "reason", "evidence_refs"],
        "properties": {
          "direction": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "uri", "date", "access", "content_hash"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1},
          "date": {"type": "string", "format": "date-time"},
          "access": {"enum": ["public", "private", "restricted"]},
          "content_hash": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_gaps": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "next_tool_task": {"type": "string", "minLength": 1},
    "required_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "audience", "contract"],
      "properties": {
        "artifact_kind": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "contract": {"type": "string", "minLength": 1}
      }
    },
    "falsification": {"type": "string", "minLength": 1},
    "data_classification": {"enum": ["public", "private", "restricted"]},
    "compression_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspected", "unavailable", "omitted"],
      "properties": {
        "inspected": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unavailable": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "omitted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "reason"],
            "properties": {
              "item": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "statement", "evidence_refs", "uncertainty"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "uncertainty": {"type": "string"}
      }
    }
  }
}
