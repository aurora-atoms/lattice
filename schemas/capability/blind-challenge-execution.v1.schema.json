{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-atoms.github.io/lattice/schemas/blind-challenge-execution.v1.schema.json",
  "title": "Blind Challenge Execution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "execution_id",
    "candidate_ref",
    "candidate_id",
    "candidate_version",
    "mission_anchor_ref",
    "created_at",
    "status",
    "simulation_status",
    "downstream_adoption_status",
    "data_classification",
    "frozen_plan",
    "blindness",
    "case_results",
    "reserved_oracle",
    "variant_mapping",
    "decision",
    "promotion_boundary",
    "evidence_refs"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "contract": {"const": "lat.blind_challenge_execution.v1"},
    "execution_id": {"type": "string", "minLength": 1},
    "candidate_ref": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "mission_anchor_ref": {"const": "lat.goal.verified-decision-yield.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["blocked_pending_reserved_oracle", "evaluated"]},
    "simulation_status": {"enum": ["synthetic_reference", "downstream_observed"]},
    "downstream_adoption_status": {"enum": ["not_observed", "observed_once", "reused"]},
    "data_classification": {"enum": ["public", "private", "restricted"]},
    "frozen_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_version",
        "primary_metric",
        "protected_metrics",
        "decision_options",
        "target_hash",
        "case_allocations_hash"
      ],
      "properties": {
        "evaluator_version": {"type": "string", "minLength": 1},
        "primary_metric": {"type": "string", "minLength": 1},
        "protected_metrics": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "decision_options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["reject", "revise", "continue_shadow", "scoped_canary"]}
        },
        "target_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "case_allocations_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "blindness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_labels_blinded_to_evaluator",
        "candidate_author_can_view_reserved_outcome",
        "reserved_oracle_visibility",
        "oracle_content_included",
        "mapping_revealed_after_evaluation"
      ],
      "properties": {
        "variant_labels_blinded_to_evaluator": {"const": true},
        "candidate_author_can_view_reserved_outcome": {"const": false},
        "reserved_oracle_visibility": {"const": "evaluator_only"},
        "oracle_content_included": {"const": false},
        "mapping_revealed_after_evaluation": {"const": true}
      }
    },
    "case_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/caseResult"}
    },
    "reserved_oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "oracle_visibility", "oracle_content_included"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["unavailable", "available"]},
        "oracle_visibility": {"const": "evaluator_only"},
        "oracle_content_included": {"const": false},
        "attestation_ref": {"type": "string", "minLength": 1},
        "attestation_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evaluated_by": {"type": "string", "minLength": 1},
        "evaluated_at": {"type": "string", "format": "date-time"}
      }
    },
    "variant_mapping": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/variantMapping"}
      ]
    },
    "decision": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/decision"}
      ]
    },
    "promotion_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic_promotion_allowed",
        "team_available_allowed",
        "human_owner_required",
        "scoped_canary_requires_human_approval"
      ],
      "properties": {
        "automatic_promotion_allowed": {"const": false},
        "team_available_allowed": {"const": false},
        "human_owner_required": {"const": true},
        "scoped_canary_requires_human_approval": {"const": true}
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "variantOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "target_result", "evidence_refs"],
      "properties": {
        "label": {"enum": ["A", "B"]},
        "target_result": {"enum": ["pass", "fail", "needs_human", "not_evaluated"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "protectedMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "status"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "not_evaluated"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "class", "variant_outcomes", "comparison", "protected_metrics", "evidence_refs"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "class": {"enum": ["representative", "hard", "counterexample", "reserved"]},
        "variant_outcomes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/variantOutcome"}
        },
        "comparison": {"enum": ["A_better", "B_better", "tie", "inconclusive"]},
        "protected_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/protectedMetric"}
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "variantMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "revealed_at"],
      "properties": {
        "A": {"type": "string", "minLength": 1},
        "B": {"type": "string", "minLength": 1},
        "revealed_at": {"type": "string", "format": "date-time"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "rationale", "human_approval_required", "team_available_allowed"],
      "properties": {
        "verdict": {"enum": ["reject", "revise", "continue_shadow", "scoped_canary"]},
        "rationale": {"type": "string", "minLength": 1},
        "human_approval_required": {"const": true},
        "team_available_allowed": {"const": false},
        "scoped_canary_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"verdict": {"const": "scoped_canary"}}},
          "then": {"required": ["scoped_canary_scope"]}
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "blocked_pending_reserved_oracle"}}},
      "then": {
        "properties": {
          "reserved_oracle": {"properties": {"status": {"const": "unavailable"}}},
          "variant_mapping": {"type": "null"},
          "decision": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "evaluated"}}},
      "then": {
        "required": ["completed_at"],
        "properties": {
          "reserved_oracle": {
            "properties": {"status": {"const": "available"}},
            "required": ["attestation_ref", "attestation_hash", "evaluated_by", "evaluated_at"]
          },
          "variant_mapping": {"$ref": "#/$defs/variantMapping"},
          "decision": {"$ref": "#/$defs/decision"}
        }
      }
    }
  ]
}
