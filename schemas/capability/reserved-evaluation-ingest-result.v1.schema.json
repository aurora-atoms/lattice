{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-atoms.github.io/lattice/schemas/reserved-evaluation-ingest-result.v1.schema.json",
  "title": "Reserved Evaluation Ingest Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "source_execution_id",
    "candidate_id",
    "candidate_version",
    "mission_anchor_ref",
    "simulation_status",
    "downstream_adoption_status",
    "data_classification",
    "request",
    "attestation",
    "reserved_case_result",
    "projection",
    "human_gate",
    "safe_evidence_refs",
    "ingest_canonical_digest"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "contract": {"const": "lat.reserved_evaluation_ingest_result.v1"},
    "source_execution_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "mission_anchor_ref": {"const": "lat.goal.verified-decision-yield.v1"},
    "simulation_status": {"enum": ["synthetic_reference", "downstream_observed"]},
    "downstream_adoption_status": {"enum": ["not_observed", "observed_once", "reused"]},
    "data_classification": {"enum": ["public", "private", "restricted"]},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_nonce", "variant_bundle_ref", "variant_bundle_digest"],
      "properties": {
        "request_nonce": {"type": "string", "minLength": 16},
        "variant_bundle_ref": {"type": "string", "pattern": "^controlled://"},
        "variant_bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_ref",
        "attestation_canonical_digest",
        "evaluator_id",
        "key_id",
        "evaluated_at",
        "signature_verified",
        "trust_verified"
      ],
      "properties": {
        "attestation_ref": {"type": "string", "pattern": "^attestation://"},
        "attestation_canonical_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evaluator_id": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "minLength": 1},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "signature_verified": {"const": true},
        "trust_verified": {"const": true}
      }
    },
    "reserved_case_result": {"$ref": "#/$defs/caseResult"},
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_status",
        "reserved_oracle_status",
        "merged_case_ids",
        "missing_case_ids",
        "all_allocations_settled",
        "ready_for_governed_adjudication"
      ],
      "properties": {
        "source_status": {"const": "blocked_pending_reserved_oracle"},
        "reserved_oracle_status": {"const": "available"},
        "merged_case_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "missing_case_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "all_allocations_settled": {"type": "boolean"},
        "ready_for_governed_adjudication": {"type": "boolean"}
      }
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governed_verdict_included",
        "variant_mapping_included",
        "governed_verdict_allowed",
        "automatic_promotion_allowed",
        "team_available_allowed",
        "human_decision_required"
      ],
      "properties": {
        "governed_verdict_included": {"const": false},
        "variant_mapping_included": {"const": false},
        "governed_verdict_allowed": {"const": false},
        "automatic_promotion_allowed": {"const": false},
        "team_available_allowed": {"const": false},
        "human_decision_required": {"const": true}
      }
    },
    "safe_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "ingest_canonical_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "variantOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "target_result", "evidence_refs"],
      "properties": {
        "label": {"enum": ["A", "B"]},
        "target_result": {"enum": ["pass", "fail", "needs_human", "not_evaluated"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "protectedMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "status", "evidence_refs"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "not_evaluated"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "class", "variant_outcomes", "comparison", "protected_metrics", "evidence_refs"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "class": {"const": "reserved"},
        "variant_outcomes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/variantOutcome"}
        },
        "comparison": {"enum": ["A_better", "B_better", "tie", "inconclusive"]},
        "protected_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/protectedMetric"}
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
