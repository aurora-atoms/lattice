{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aurora-atoms/lattice/schemas/capability/skill-ci-contract-report.v1.schema.json",
  "title": "Skill CI Contract Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "base_ref",
    "head_ref",
    "changed_skills",
    "summary",
    "findings"
  ],
  "properties": {
    "contract": {
      "const": "lat.skill-ci-contract-report.v1"
    },
    "base_ref": {
      "type": "string",
      "minLength": 1
    },
    "head_ref": {
      "type": "string",
      "minLength": 1
    },
    "changed_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings"],
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "path", "message"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_.-]+$"
          },
          "severity": {
            "enum": ["error", "warning"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
