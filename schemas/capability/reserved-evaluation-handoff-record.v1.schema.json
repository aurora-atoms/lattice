{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-atoms.github.io/lattice/schemas/reserved-evaluation-handoff-record.v1.schema.json",
  "title": "Reserved Evaluation Handoff Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "schema",
    "source",
    "target",
    "scope",
    "payload",
    "constraints"
  ],
  "properties": {
    "type": {
      "enum": [
        "eval.reserved_request",
        "eval.reserved_attestation"
      ]
    },
    "id": {"type": "string", "minLength": 1},
    "schema": {"const": "lat.reserved_evaluation_handoff.v1"},
    "source": {"$ref": "#/$defs/endpoint"},
    "target": {"$ref": "#/$defs/endpoint"},
    "scope": {"$ref": "#/$defs/scope"},
    "payload": {"type": "object"},
    "constraints": {"$ref": "#/$defs/constraints"}
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "role"],
      "properties": {
        "boundary": {
          "enum": [
            "public_repository",
            "controlled_private_evaluator"
          ]
        },
        "role": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_version",
        "execution_id",
        "reserved_case_id",
        "mission_anchor_ref",
        "target_hash",
        "case_allocations_hash"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "candidate_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "execution_id": {"type": "string", "minLength": 1},
        "reserved_case_id": {"type": "string", "minLength": 1},
        "mission_anchor_ref": {"const": "lat.goal.verified-decision-yield.v1"},
        "target_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "case_allocations_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle_visibility",
        "oracle_content_allowed",
        "raw_private_evidence_allowed",
        "variant_mapping_allowed",
        "governed_verdict_allowed",
        "automatic_promotion_allowed",
        "team_available_allowed"
      ],
      "properties": {
        "oracle_visibility": {"const": "evaluator_only"},
        "oracle_content_allowed": {"const": false},
        "raw_private_evidence_allowed": {"const": false},
        "variant_mapping_allowed": {"const": false},
        "governed_verdict_allowed": {"const": false},
        "automatic_promotion_allowed": {"const": false},
        "team_available_allowed": {"const": false}
      }
    },
    "requestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issued_at",
        "evaluator_version",
        "primary_metric",
        "protected_metrics",
        "variant_bundle_ref",
        "variant_labels",
        "requested_outputs"
      ],
      "properties": {
        "status": {"const": "awaiting_external_evaluator"},
        "issued_at": {"type": "string", "format": "date-time"},
        "evaluator_version": {"type": "string", "minLength": 1},
        "primary_metric": {"type": "string", "minLength": 1},
        "protected_metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "variant_bundle_ref": {"type": "string", "pattern": "^controlled://.+"},
        "variant_labels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["A", "B"]}
        },
        "requested_outputs": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "anonymous_variant_outcomes",
              "comparison",
              "protected_metrics",
              "attestation_digest"
            ]
          }
        }
      }
    },
    "variantOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "target_result", "evidence_refs"],
      "properties": {
        "label": {"enum": ["A", "B"]},
        "target_result": {"enum": ["pass", "fail", "needs_human", "not_evaluated"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "protectedMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "status", "evidence_refs"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "not_evaluated"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "reservedCaseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "class",
        "variant_outcomes",
        "comparison",
        "protected_metrics",
        "evidence_refs"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "class": {"const": "reserved"},
        "variant_outcomes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/variantOutcome"}
        },
        "comparison": {"enum": ["A_better", "B_better", "tie", "inconclusive"]},
        "protected_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/protectedMetric"}
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "attestationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evaluator_version",
        "evaluated_by",
        "evaluated_at",
        "variant_bundle_ref",
        "reserved_case_result",
        "oracle_used",
        "oracle_content_included",
        "variant_mapping_included",
        "governed_verdict_included",
        "attestation_ref",
        "attestation_hash"
      ],
      "properties": {
        "status": {"const": "completed"},
        "evaluator_version": {"type": "string", "minLength": 1},
        "evaluated_by": {"type": "string", "minLength": 1},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "variant_bundle_ref": {"type": "string", "pattern": "^controlled://.+"},
        "reserved_case_result": {"$ref": "#/$defs/reservedCaseResult"},
        "oracle_used": {"const": true},
        "oracle_content_included": {"const": false},
        "variant_mapping_included": {"const": false},
        "governed_verdict_included": {"const": false},
        "attestation_ref": {"type": "string", "pattern": "^attestation://.+"},
        "attestation_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "eval.reserved_request"}}},
      "then": {
        "properties": {
          "source": {
            "properties": {
              "boundary": {"const": "public_repository"},
              "role": {"const": "reserved_evaluation_coordinator"}
            }
          },
          "target": {
            "properties": {
              "boundary": {"const": "controlled_private_evaluator"},
              "role": {"const": "reserved_oracle_evaluator"}
            }
          },
          "payload": {"$ref": "#/$defs/requestPayload"}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "eval.reserved_attestation"}}},
      "then": {
        "properties": {
          "source": {
            "properties": {
              "boundary": {"const": "controlled_private_evaluator"},
              "role": {"const": "reserved_oracle_evaluator"}
            }
          },
          "target": {
            "properties": {
              "boundary": {"const": "public_repository"},
              "role": {"const": "reserved_evaluation_coordinator"}
            }
          },
          "payload": {"$ref": "#/$defs/attestationPayload"}
        }
      }
    }
  ]
}
