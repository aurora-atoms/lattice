{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-atoms.github.io/lattice/schemas/canonical-capability-manifest.v1.schema.json",
  "title": "Canonical Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "public_package_status_contract",
    "capability_roles",
    "capabilities"
  ],
  "properties": {
    "contract": {
      "const": "lat.canonical-capability-manifest.v1"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "public_package_status_contract": {
      "const": "schemas/capability/public-package-lifecycle.v1.schema.json"
    },
    "capability_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability_role"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "capability_role": {
      "type": "string",
      "enum": [
        "atomic_capability",
        "selector",
        "reference_workflow",
        "capability_profile",
        "projection",
        "validator",
        "template",
        "governance_contract"
      ]
    },
    "public_package_status": {
      "type": "string",
      "enum": [
        "draft",
        "contract_validated",
        "conformance_validated",
        "released",
        "deprecated"
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "record_type",
        "family_name",
        "version",
        "capability_role",
        "public_package_status",
        "path",
        "description",
        "changes",
        "primary_user",
        "secondary_audience",
        "trigger",
        "minimum_inputs",
        "outputs",
        "evidence_contract",
        "success_signals",
        "stop_conditions",
        "authority_boundary",
        "compatibility",
        "deprecated_by",
        "projection"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^(skill|agent|mcp|knowledge|workspace):[a-z0-9][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "skill",
            "agent",
            "mcp",
            "knowledge_pack",
            "workspace_template"
          ]
        },
        "family_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "capability_role": {
          "$ref": "#/$defs/capability_role"
        },
        "public_package_status": {
          "$ref": "#/$defs/public_package_status"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 20
        },
        "changes": {
          "type": "string",
          "minLength": 1
        },
        "primary_user": {
          "type": "string",
          "minLength": 1
        },
        "secondary_audience": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "minimum_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_sections",
            "policy"
          ],
          "properties": {
            "required_sections": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "policy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "success_signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authority_boundary": {
          "type": "string",
          "minLength": 1
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantic_versioning",
            "legacy_status_field",
            "migration"
          ],
          "properties": {
            "semantic_versioning": {
              "const": true
            },
            "legacy_status_field": {
              "type": "string",
              "minLength": 1
            },
            "migration": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "deprecated_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "source_registry",
            "legacy_record"
          ],
          "properties": {
            "source_registry": {
              "type": "string",
              "minLength": 1
            },
            "context_catalog": {
              "type": "string"
            },
            "legacy_record": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
