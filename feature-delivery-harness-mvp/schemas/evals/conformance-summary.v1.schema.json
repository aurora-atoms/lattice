{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-atoms.github.io/lattice/schemas/evals/conformance-summary.v1.schema.json",
  "title": "Heterogeneous Conformance Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "total",
    "passed",
    "failed",
    "results"
  ],
  "properties": {
    "contract": {"const": "lat.conformance-summary.v1"},
    "schema_version": {"const": "1.0.0"},
    "total": {"type": "integer", "minimum": 0},
    "passed": {"type": "integer", "minimum": 0},
    "failed": {"type": "integer", "minimum": 0},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "case_type", "status", "note"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "case_type": {
            "enum": [
              "feature_delivery",
              "reusable_asset_loop",
              "synthetic_downstream",
              "unknown"
            ]
          },
          "status": {"enum": ["pass", "fail"]},
          "note": {"type": "string"}
        }
      }
    }
  }
}
