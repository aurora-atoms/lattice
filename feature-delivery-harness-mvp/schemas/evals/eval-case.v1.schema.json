{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-atoms.github.io/lattice/schemas/evals/eval-case.v1.schema.json",
  "title": "Heterogeneous Conformance Eval Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "case_id",
    "case_type",
    "required_files"
  ],
  "properties": {
    "contract": {"const": "lat.eval-case.v1"},
    "schema_version": {"const": "1.0.0"},
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "case_type": {
      "enum": [
        "feature_delivery",
        "reusable_asset_loop",
        "synthetic_downstream"
      ]
    },
    "required_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    }
  }
}
