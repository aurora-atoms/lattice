{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lat/reusable-asset-loop.v1.schema.json",
  "title": "Reusable Asset Loop Record Set",
  "description": "A bounded Experience-to-Asset vertical slice. Runtime semantic validation is performed by run_reusable_asset_loop.py.",
  "type": "array",
  "minItems": 5,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["type", "id", "schema", "source", "target", "scope", "payload", "constraints"],
    "properties": {
      "type": {
        "enum": [
          "experience.contribution",
          "reusable_asset.candidate",
          "reusable_asset.change_proposal",
          "reusable_asset.review",
          "reusable_asset.usage_observation"
        ]
      },
      "id": {"type": "string", "minLength": 1},
      "schema": {"type": "string", "pattern": "^lat\\."},
      "source": {"type": "string", "minLength": 1},
      "target": {"type": "string", "minLength": 1},
      "scope": {
        "type": "object",
        "required": ["project_id", "feature_delivery_case_id", "module_id"],
        "properties": {
          "project_id": {"const": "lattice"},
          "feature_delivery_case_id": {"type": "string", "minLength": 1},
          "module_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "payload": {"type": "object"},
      "constraints": {"type": "object"}
    }
  }
}
