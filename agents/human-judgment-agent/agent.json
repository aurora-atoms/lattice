{
  "id": "human-judgment-agent@1.0.0",
  "name": "human-judgment-agent",
  "description": "Route category G expert-attention, mentorship, and invisible-work tasks.",
  "owner": "aurora-atoms",
  "status": "experimental",
  "role": "human-judgment-agent",
  "scope": {"allowed": ["project"]},
  "risk_level": "medium",
  "data_classification": "public",
  "instruction_source": {"path": "agents/human-judgment-agent/human-judgment-agent.agent.md", "format": "markdown", "hash_required": true},
  "skills": [{"skill_id": "human-judgment-amplifier", "required": true, "implicit": true}],
  "mcp": [],
  "knowledge": [],
  "token_budget": {
    "max_instruction_chars": 7000,
    "max_skill_catalog_chars": 10000,
    "max_active_mcp_tools": 20,
    "max_knowledge_index_items": 20
  },
  "cache": {
    "deterministic_order": true,
    "no_timestamps": true,
