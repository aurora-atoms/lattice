{
  "id": "delivery-capability-conductor@1.0.0",
  "name": "delivery-capability-conductor",
  "description": "Route feature delivery work to the smallest necessary skill or agent using role, lifecycle stage, evidence, permissions, and desired visible outcome.",
  "owner": "aurora-atoms",
  "status": "experimental",
  "role": "delivery-capability-conductor",
  "scope": {"allowed": ["project"]},
  "risk_level": "medium",
  "data_classification": "public",
  "instruction_source": {
    "path": "agents/delivery-capability-conductor/delivery-capability-conductor.agent.md",
    "format": "markdown",
