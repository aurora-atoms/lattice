  },
  "skills": [
    {
      "skill_id": "delivery-capability-conductor",
      "required": true,
      "implicit": true
    }
  ],
  "mcp": [],
  "knowledge": [],
  "token_budget": {
    "max_instruction_chars": 7000,
    "max_skill_catalog_chars": 10000,
