{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lat/feature-delivery-case.lifecycle.v1.schema.json",
  "title": "Feature Delivery Case Lifecycle V1",
  "type": "object",
  "required": [
    "case_profile",
    "case_id",
    "revision",
    "title",
    "lifecycle_status",
    "accountable_owner",
    "purpose",
    "boundary",
    "acceptance_criteria",
    "context_coverage",
    "decision_log",
    "assumption_log",
    "dependencies",
    "evidence_ledger",
    "risk_ledger",
    "unresolved_items",
    "artifacts",
    "readiness"
  ],
  "properties": {
    "case_profile": {"const": "lifecycle_v1"},
    "case_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "lifecycle_status": {
      "type": "string",
      "enum": ["draft", "ready", "in_progress", "delivered", "failed", "blocked", "superseded", "abandoned"]
    },
    "accountable_owner": {"type": "string", "minLength": 1},
    "purpose": {
      "type": "object",
      "required": ["why", "beneficiaries", "expected_change", "success_signals"],
      "properties": {
        "why": {"type": "string", "minLength": 1},
        "beneficiaries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expected_change": {"type": "string", "minLength": 1},
        "success_signals": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": ["feature_boundary", "in_scope", "out_of_scope", "affected_surfaces", "impact_areas", "compatibility_constraints", "non_goals"],
      "properties": {
        "feature_boundary": {"type": "string", "minLength": 1},
        "in_scope": {"type": "array", "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}},
        "affected_surfaces": {"type": "array", "items": {"type": "string"}},
        "impact_areas": {"type": "array", "items": {"type": "string"}},
        "compatibility_constraints": {"type": "array", "items": {"type": "string"}},
        "non_goals": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "evidence_requirements"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "evidence_requirements": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "context_coverage": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["category", "status", "search_scope", "source_refs", "findings"],
        "properties": {
          "category": {"type": "string", "enum": ["business_rules", "system_constraints", "similar_cases", "negative_knowledge", "source_facts"]},
          "status": {"type": "string", "enum": ["found", "none_found", "not_applicable", "pending"]},
          "search_scope": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "findings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "decision_log": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "assumption_log": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "evidence_ledger": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "risk_ledger": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "unresolved_items": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "readiness": {
      "type": "object",
      "required": ["target", "result", "criteria", "blocking_item_refs", "evidence_refs", "assessed_at", "expires_at", "review_triggers", "authority_note"],
      "properties": {
        "target": {"type": "string", "enum": ["refinement", "implementation", "test", "review", "merge", "deployment", "release", "next_step"]},
        "result": {"type": "string", "enum": ["ready", "not_ready", "blocked", "insufficient_evidence", "human_decision_required"]},
        "criteria": {"type": "array", "items": {"type": "object", "required": ["id", "status", "evidence_refs"], "properties": {"id": {"type": "string"}, "status": {"type": "string", "enum": ["pass", "fail", "unknown", "not_applicable"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
        "blocking_item_refs": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "assessed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "review_triggers": {"type": "array", "items": {"type": "string"}},
        "authority_note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "review_condition": {
      "type": "object",
      "required": ["review_at", "event_triggers"],
      "properties": {
        "review_at": {"type": ["string", "null"], "format": "date-time"},
        "event_triggers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["id", "status", "choice", "decided_at", "decision_owner", "rationale", "alternatives", "applicability_conditions", "evidence_refs", "review_condition", "supersedes"],
      "properties": {
        "id": {"type": "string"},
        "status": {"type": "string", "enum": ["active", "superseded", "reversed", "pending", "waived"]},
        "choice": {"type": "string"},
        "decided_at": {"type": "string", "format": "date-time"},
        "decision_owner": {"type": "string"},
        "rationale": {"type": "string"},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "applicability_conditions": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "review_condition": {"$ref": "#/$defs/review_condition"},
        "supersedes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "required": ["id", "status", "statement", "basis", "owner", "confidence", "validity_conditions", "expires_at", "review_condition", "impact_if_false", "evidence_refs"],
      "properties": {
        "id": {"type": "string"},
        "status": {"type": "string", "enum": ["active", "expired", "invalidated", "superseded", "unsupported", "waived"]},
        "statement": {"type": "string"},
        "basis": {"type": "string"},
        "owner": {"type": "string"},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "validity_conditions": {"type": "array", "items": {"type": "string"}},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "review_condition": {"$ref": "#/$defs/review_condition"},
        "impact_if_false": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["id", "kind", "name", "state", "blocking", "owner", "required_participants", "evidence_refs", "review_triggers"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string", "enum": ["technical", "shadow", "data", "operational", "external", "decision", "stakeholder"]},
        "name": {"type": "string"},
        "state": {"type": "string", "enum": ["unknown", "identified", "pending", "satisfied", "waived", "failed", "blocked"]},
        "blocking": {"type": "boolean"},
        "owner": {"type": "string"},
        "required_participants": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "review_triggers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "kind", "source_ref", "relation", "supports_refs", "result", "observed_at", "expires_at", "confidence", "source_authority"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string", "enum": ["test", "log", "review", "metric", "validation", "fact_source", "manual_acceptance", "other"]},
        "source_ref": {"type": "string"},
        "relation": {"type": "string", "enum": ["supports", "contradicts", "inconclusive"]},
        "supports_refs": {"type": "array", "items": {"type": "string"}},
        "result": {"type": "string"},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "source_authority": {"type": "string"}
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": ["id", "kind", "statement", "component_refs", "owner", "exposure", "controls", "evidence_refs", "review_triggers", "status"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string", "enum": ["direct", "compound", "uncertainty"]},
        "statement": {"type": "string"},
        "component_refs": {"type": "array", "items": {"type": "string"}},
        "owner": {"type": "string"},
        "exposure": {"type": "string", "enum": ["low", "medium", "high", "critical", "unknown"]},
        "controls": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "review_triggers": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["open", "controlled", "accepted", "realized", "closed"]}
      },
      "additionalProperties": false
    },
    "unresolved": {
      "type": "object",
      "required": ["id", "kind", "statement", "blocking", "owner", "due_at", "review_triggers", "status"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string", "enum": ["question", "decision", "missing_evidence", "waiver", "expired_assumption", "conflict"]},
        "statement": {"type": "string"},
        "blocking": {"type": "boolean"},
        "owner": {"type": "string"},
        "due_at": {"type": ["string", "null"], "format": "date-time"},
        "review_triggers": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["open", "resolved", "waived"]}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["id", "kind", "uri", "case_revision", "owner", "evidence_refs", "generated_at", "expires_at", "review_triggers", "authority_note"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string", "enum": ["case_summary", "jira_ticket", "implementation_handoff", "test_handoff", "pr_readiness", "readiness_card", "deployment_handoff", "release_summary", "next_step_handoff"]},
        "uri": {"type": "string"},
        "case_revision": {"type": "integer", "minimum": 1},
        "owner": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "generated_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "review_triggers": {"type": "array", "items": {"type": "string"}},
        "authority_note": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
