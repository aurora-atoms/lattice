{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lat.unasked_questions.v1",
  "title": "Unasked Questions Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "review_id", "stage", "next_gate", "scope", "evidence_cutoff", "coverage", "questions", "control_summary"],
  "properties": {
    "record_type": {"const": "lat.unasked_questions.v1"},
    "review_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "next_gate": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "non_scope": {"type": "array", "items": {"type": "string"}},
    "evidence_cutoff": {"type": "string", "minLength": 1},
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "status", "rationale"],
        "properties": {
          "domain": {"type": "string", "minLength": 1},
          "status": {"enum": ["covered", "missing", "not_applicable", "not_assessable"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "domain", "importance", "ranking", "evidence", "affected_boundaries", "consequence", "answer_role", "latest_safe_answer_time", "gate", "disposition", "blocking_rationale", "expected_answer_form", "next_action", "confidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "omission_reason": {"type": "string"},
          "importance": {"type": "string", "minLength": 1},
          "ranking": {"enum": ["critical", "high", "medium", "low"]},
          "ranking_rationale": {"type": "string"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "affected_boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "consequence": {"type": "string", "minLength": 1},
          "answer_role": {"type": "string", "minLength": 1},
          "latest_safe_answer_time": {"type": "string", "minLength": 1},
          "gate": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["must_answer_now", "must_answer_before_implementation", "must_answer_before_merge", "must_answer_before_release", "answer_by_observation", "accepted_uncertainty", "non_blocking_follow_up", "excluded"]},
          "blocking_rationale": {"type": "string", "minLength": 1},
          "expected_answer_form": {"type": "string", "minLength": 1},
          "next_action": {"type": "string", "minLength": 1},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "conflicts": {"type": "array", "items": {"type": "string"}},
          "unknowns": {"type": "array", "items": {"type": "string"}},
          "monitoring": {"type": "string"},
          "reopen_trigger": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "disconfirming_evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "control_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposed_blockers", "accepted_uncertainty", "human_authorities"],
      "properties": {
        "proposed_blockers": {"type": "array", "items": {"type": "string"}},
        "accepted_uncertainty": {"type": "array", "items": {"type": "string"}},
        "human_authorities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "handoff_candidates": {"type": "array", "items": {"type": "object"}}
  }
}
