{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-atoms.github.io/lattice/skills/delivery-rescue/schemas/bug-investigation.v1.schema.json",
  "title": "Bug Investigation Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "investigation_id",
    "case_ref",
    "target",
    "blocker",
    "reproduction",
    "observations",
    "hypotheses",
    "verification_tests",
    "root_cause",
    "minimum_next_step",
    "fix_readiness",
    "evidence_summary",
    "human_confirmation_points",
    "simulation_status",
    "downstream_adoption_status"
  ],
  "properties": {
    "record_type": {
      "const": "lat.bug_investigation.v1"
    },
    "investigation_id": {
      "type": "string",
      "minLength": 1
    },
    "case_ref": {
      "$ref": "#/$defs/uriRef"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "included", "excluded", "evidence_cutoff"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "included": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_cutoff": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observed_failure", "expected_behavior", "evidence_refs"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ci_failure",
            "failing_test",
            "runtime_bug",
            "environment_failure",
            "contract_break",
            "reproducibility_gap",
            "unknown"
          ]
        },
        "observed_failure": {
          "type": "string",
          "minLength": 1
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonEmptyUriRefs"
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "attempts",
        "last_attempt_at",
        "steps",
        "environment_refs",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_attempted", "not_reproduced", "intermittent", "reproduced"]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "last_attempt_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environment_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uriRef"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uriRef"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "verification_tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verificationTest"
      }
    },
    "root_cause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "hypothesis_id",
        "rationale",
        "evidence_refs",
        "strongest_alternative_hypothesis_id",
        "alternative_disposition"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unknown", "hypothesis_supported", "verified"]
        },
        "hypothesis_id": {
          "type": ["string", "null"]
        },
        "rationale": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uriRef"
          }
        },
        "strongest_alternative_hypothesis_id": {
          "type": ["string", "null"]
        },
        "alternative_disposition": {
          "type": "string",
          "enum": [
            "not_applicable",
            "falsified",
            "weakened",
            "accepted_residual_risk",
            "unresolved"
          ]
        }
      }
    },
    "minimum_next_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action", "validation", "expected_signal", "stop_condition"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["reproduce", "falsify", "collect_evidence", "repair", "escalate"]
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "validation": {
          "type": "string",
          "minLength": 1
        },
        "expected_signal": {
          "type": "string",
          "minLength": 1
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fix_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "proposed_fix_scope",
        "acceptance_observer",
        "validation_commands",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_ready", "ready_for_bounded_fix", "requires_human_review", "blocked"]
        },
        "proposed_fix_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_observer": {
          "type": "string"
        },
        "validation_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uriRef"
          }
        }
      }
    },
    "evidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "inference_summary",
        "citations",
        "counterevidence",
        "uncertainty",
        "unknowns",
        "assumptions"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inference_summary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "citations": {
          "$ref": "#/$defs/nonEmptyUriRefs"
        },
        "counterevidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uriRef"
          }
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unknown"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "human_confirmation_points": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "simulation_status": {
      "type": "string",
      "enum": ["synthetic_reference", "downstream_observed"]
    },
    "downstream_adoption_status": {
      "type": "string",
      "enum": [
        "not_observed",
        "imported",
        "task_scoped",
        "used_once",
        "reused",
        "team_available",
        "deprecated"
      ]
    }
  },
  "$defs": {
    "uriRef": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://\\S+$"
    },
    "nonEmptyUriRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/uriRef"
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "statement", "relationship", "observed_at", "evidence_refs"],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "type": "string",
          "enum": ["direct_observation", "correlation", "controlled_change_result"]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonEmptyUriRefs"
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "statement",
        "status",
        "material",
        "evidence_for",
        "evidence_against",
        "unknowns"
      ],
      "properties": {
        "hypothesis_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["plausible", "strengthened", "weakened", "falsified", "supported"]
        },
        "material": {
          "type": "boolean"
        },
        "evidence_for": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uriRef"
          }
        },
        "evidence_against": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uriRef"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verificationTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "target_hypothesis_id",
        "method",
        "procedure",
        "expected_disconfirming_signal",
        "outcome",
        "evidence_refs"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "target_hypothesis_id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "enum": [
            "reproduction_variation",
            "test_isolation",
            "controlled_change",
            "bisect",
            "contract_check",
            "environment_comparison"
          ]
        },
        "procedure": {
          "type": "string",
          "minLength": 1
        },
        "expected_disconfirming_signal": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "enum": ["not_run", "supports", "weakens", "falsifies"]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uriRef"
          }
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_id", "statement", "blocking"],
      "properties": {
        "unknown_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        }
      }
    }
  }
}
