{
  "contract":"lat.capability-context.v1",
  "contract_version":"1.1.0",
  "default_version":"1.0.0",
  "breaking_change_policy":"semantic_versioning",
  "optional_context_discovery":"Use native discovery to find the smallest related Skill, Agent, bounded codebase, governed knowledge source, official research source, or human review needed for the named quality gap.",
  "run_result_contract":{"schema":"schemas/capability/capability-run-result.v1.schema.json","record_type":"lat.capability.run_result.v1","writeback_pattern":"artifacts/capability-runs/<capability-name>/<run-id>/run-result.json","visible_artifact_required":true,"inline_fallback":"When repository or local write permission is unavailable, return the complete structured result inline and mark write_status=returned_inline."},
  "evidence_contract":{"required_sections":["facts","inference_summary","citations","uncertainty","unknowns","assumptions"],"policy":"Separate source-supported facts from inference. Cite addressable sources. State uncertainty, unknowns, assumptions, and guesses explicitly. Do not continue analysis beyond the evidence boundary."},
  "success_contract":{"required":true,"result_enum":["met","not_met","not_evaluated"],"policy":"Evaluate each declared success signal against evidence before reporting completion."},
  "stop_contract":{"default_retry_budget":1,"stage_gate_by_default":true,"continue_to_final_goal_only_when_explicitly_requested":true,"reasons":["goal_reached","stage_gate_reached","retry_budget_exhausted","missing_permission","missing_required_input","source_unavailable","insufficient_evidence","high_risk_boundary","human_decision_required","explicit_user_stop","failed_validation"],"policy":"Stop at the requested result or next reviewable stage. Do not repeatedly probe missing permissions, unavailable sources, absent facts, insufficient evidence, or high-risk boundaries. State what is missing, who can provide or approve it, and the exact next step."},
  "agents":[
    {"name":"pr-reviewer","path":"agents/pr-reviewer/pr-reviewer.agent.md","changes":"a pull request into prioritized review findings","primary_user":"PR review agent","secondary_audience":["authors and maintainers"],"trigger":"a pull request opens or changes","minimum":["PR intent, diff, tests, and constraints"],"outputs":["review findings and readiness recommendation"],"runtime_targets":["codex","github-copilot"]},
    {"name":"python-expert","path":"agents/python-expert/python-expert.agent.md","changes":"a bounded Python task into validated implementation","primary_user":"Python implementation agent","secondary_audience":["reviewers and maintainers"],"trigger":"a Python task is assigned","minimum":["objective, target files, constraints, and validation"],"outputs":["Python changes and validation evidence"],"runtime_targets":["codex","github-copilot"]},
    {"name":"delivery-capability-conductor","path":"agents/delivery-capability-conductor/delivery-capability-conductor.agent.md","changes":"a delivery request into a bounded capability handoff","primary_user":"native coordinator","secondary_audience":["specialist agents and delivery owners"],"trigger":"a new task or stage change occurs","minimum":["case, outcome, and permission boundary"],"outputs":["routing decision and handoff"],"runtime_targets":["codex","github-copilot"]},
    {"name":"delivery-rescue-agent","path":"agents/delivery-rescue-agent/delivery-rescue-agent.agent.md","changes":"failure evidence into a recovery path","primary_user":"delivery coordinator","secondary_audience":["developers and reviewers"],"trigger":"a delivery failure occurs","minimum":["failure evidence and expected behavior"],"outputs":["diagnosis and recovery plan"],"runtime_targets":["codex","github-copilot"]},
    {"name":"context-mastery-agent","path":"agents/context-mastery-agent/context-mastery-agent.agent.md","changes":"scattered evidence into a bounded context pack","primary_user":"delivery coordinator","secondary_audience":["coding agents and reviewers"],"trigger":"task context is unclear","minimum":["task objective and source access"],"outputs":["bounded context pack"],"runtime_targets":["codex","github-copilot"]},
    {"name":"knowledge-integrity-agent","path":"agents/knowledge-integrity-agent/knowledge-integrity-agent.agent.md","changes":"conflicting knowledge into scoped decisions","primary_user":"delivery coordinator","secondary_audience":["architects and maintainers"],"trigger":"knowledge changes or conflicts","minimum":["claims, scope, and source references"],"outputs":["trust assessment and review triggers"],"runtime_targets":["codex","github-copilot"]},
    {"name":"risk-sentinel-agent","path":"agents/risk-sentinel-agent/risk-sentinel-agent.agent.md","changes":"latent exposure into explicit controls","primary_user":"delivery coordinator","secondary_audience":["owners and risk reviewers"],"trigger":"a task approaches commitment","minimum":["task, dependencies, and constraints"],"outputs":["risk preflight and controls"],"runtime_targets":["codex","github-copilot"]},
    {"name":"delivery-artifact-agent","path":"agents/delivery-artifact-agent/delivery-artifact-agent.agent.md","changes":"delivery evidence into a shareable artifact","primary_user":"delivery coordinator","secondary_audience":["artifact owners and reviewers"],"trigger":"a delivery artifact is requested","minimum":["case, artifact type, and evidence"],"outputs":["editable delivery artifact"],"runtime_targets":["codex","github-copilot"]},
    {"name":"delivery-learning-agent","path":"agents/delivery-learning-agent/delivery-learning-agent.agent.md","changes":"outcomes into learning candidates","primary_user":"delivery coordinator","secondary_audience":["team leads and future agents"],"trigger":"a delivery outcome completes","minimum":["outcome, evidence, and scope"],"outputs":["learning candidate and measurement plan"],"runtime_targets":["codex","github-copilot"]},
    {"name":"human-judgment-agent","path":"agents/human-judgment-agent/human-judgment-agent.agent.md","changes":"an automation boundary into a human decision request","primary_user":"delivery coordinator","secondary_audience":["accountable experts and mentors"],"trigger":"human authority or expertise is required","minimum":["decision objective, evidence, and options"],"outputs":["decision or expert-attention packet"],"runtime_targets":["codex","github-copilot"]},
    {"name":"management-translation-agent","path":"agents/management-translation-agent/management-translation-agent.agent.md","changes":"technical evidence into a management artifact","primary_user":"delivery coordinator","secondary_audience":["engineering and business leaders"],"trigger":"management review is needed","minimum":["status, evidence, audience, and decision need"],"outputs":["management brief or escalation"],"runtime_targets":["codex","github-copilot"]},
    {"name":"delivery-capability-strategy-agent","path":"agents/delivery-capability-strategy-agent/delivery-capability-strategy-agent.agent.md","changes":"capability evidence into adoption strategy","primary_user":"delivery coordinator","secondary_audience":["engineering leaders and capability owners"],"trigger":"strategy review is requested","minimum":["outcomes, economics, and constraints"],"outputs":["strategy recommendation"],"runtime_targets":["codex","github-copilot"]},
    {"name":"capability-harness-engineer","path":"agents/capability-harness-engineer/capability-harness-engineer.agent.md","changes":"metadata and runtime evidence into improved harness behavior","primary_user":"Skill maintainer","secondary_audience":["runtime adapter owners and reviewers"],"trigger":"discovery or orchestration misbehaves","minimum":["runtime evidence, metadata, and evaluation cases"],"outputs":["harness assessment and changes"],"runtime_targets":["codex","github-copilot"]}
  ]
}
